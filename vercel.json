{
  "routes": [
    {
      "src": "/\\.well-known/assetlinks\\.json",
      "headers": {
        "Content-Type": "application/json"
      },
      "dest": "/.well-known/assetlinks.json"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
